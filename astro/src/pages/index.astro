---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Universal Editor — Astro">
  <section style="text-align:center; margin-bottom:2.5rem;">
    <p style="color:var(--orange); font-size:0.8rem; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; margin-bottom:0.75rem;">
      Astro scaffold · v1.1.5
    </p>
    <h1 style="font-size:clamp(2rem,4vw,2.8rem); font-weight:800; margin-bottom:0.75rem;">
      Universal <span style="color:var(--orange)">Editor</span>
    </h1>
    <p style="color:var(--muted); max-width:480px; margin:0 auto 1.5rem;">
      Component-driven Astro structure aligned with the static editor modules.
      Independent tool by FoxPhantom203 — not affiliated with Adobe.
    </p>
    <a
      href="https://universal-editor-203.github.io/editor.html"
      style="display:inline-block; background:var(--orange); color:#000; font-weight:700; padding:0.75rem 1.5rem; border-radius:8px;"
    >
      Open static editor
    </a>
  </section>

  <section style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:1rem;">
    {['Video', 'ROM', 'File', 'Music', 'Rust'].map((name) => (
      <div style="background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:1.25rem;">
        <h3 style="color:var(--orange); margin-bottom:0.35rem;">{name}</h3>
        <p style="color:var(--muted); font-size:0.9rem;">Module aligned with the main Universal Editor workspace.</p>
      </div>
    ))}
  </section>
</Layout>
